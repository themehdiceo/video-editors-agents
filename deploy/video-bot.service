[Unit]
Description=Equipe de montage video (bot Telegram + agents Claude Code)
After=network-online.target telegram-bot-api.service
Wants=network-online.target

[Service]
User=editor
WorkingDirectory=/opt/video-editors-agents/bot
EnvironmentFile=/etc/video-editors-agents/.env
Environment=REPO_DIR=/opt/video-editors-agents
Environment=PATH=/opt/video-editors-agents/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/video-editors-agents/.venv/bin/python bot.py
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
