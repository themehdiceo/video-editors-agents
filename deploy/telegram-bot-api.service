[Unit]
Description=Serveur Bot API Telegram local (fichiers jusqu'a 2 Go)
After=docker.service
Requires=docker.service

[Service]
EnvironmentFile=/etc/video-editors-agents/.env
ExecStartPre=-/usr/bin/docker rm -f telegram-bot-api
ExecStart=/usr/bin/docker run --rm --name telegram-bot-api -p 127.0.0.1:8081:8081 \
  -e TELEGRAM_API_ID=${TELEGRAM_API_ID} -e TELEGRAM_API_HASH=${TELEGRAM_API_HASH} -e TELEGRAM_LOCAL=1 \
  -v /var/lib/telegram-bot-api:/var/lib/telegram-bot-api aiogram/telegram-bot-api:latest
Restart=always

[Install]
WantedBy=multi-user.target
